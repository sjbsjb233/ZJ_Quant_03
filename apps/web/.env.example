# Copy to .env and adjust. Read by docker-compose.yml (V3 五容器拓扑) and the apps.

# === Deployment (read by docker-compose.yml) ===
# Public host port (web-frontend nginx always listens on 80 inside the container).
WEB_PORT=80
# CORS allow-list. Browser only ever talks to web-frontend (single origin), so this
# mostly matters for direct backend access during dev (Vite on 5173).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80

# Optional GHCR images to pull instead of building locally (leave unset → build).
#   WEB_FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/web-frontend:latest
#   WEB_BACKEND_IMAGE=ghcr.io/<owner>/<repo>/web-backend:latest
#   DATA_KEEPER_IMAGE=ghcr.io/<owner>/<repo>/data-keeper:latest
#   FACTOR_IMAGE=ghcr.io/<owner>/<repo>/factor:latest

# === Shared secrets (ALL services) ===
# JWT signing secret — CHANGE IN PRODUCTION. Shared so keeper/factor can trust the
# web proxy's X-Forwarded-User/-Role and decode a direct bearer token.
JWT_SECRET=dev-secret-change-me-in-prod
# Service-to-service log ingest token (NOT a user JWT). data-keeper / factor POST
# their structured logs to web-backend /logs/ingest carrying X-Log-Token: <this>.
LOG_INGEST_TOKEN=change-me-log-token

# === data-keeper (唯一写者) ===
# In-process scheduler (autonomous crawl / quality / maintenance). false = off (rollback).
ENABLE_SCHEDULER=true
# tushare 备源 token (akshare 主源无需 token). Empty disables the tushare fallback.
TUSHARE_TOKEN=

# === factor service ===
FACTOR_CONCURRENCY=4
FACTOR_RESERVE_INTERACTIVE=1
FACTOR_POLL_INTERVAL_MS=1000

# === Local (non-compose) dev overrides — read directly by the apps ===
# These default sensibly in compose; set them only for a bare `uvicorn` run.
QUANT_DATA_ROOT=./data
AUDIT_DB_URL=sqlite:///./quant_web_audit.db
# data-keeper base for web write-forwarding. UNSET → web writes locally (dev default).
# KEEPER_BASE=http://localhost:8300
JOB_WORKERS=4
SEED_DEFAULT_USERS=true

# === logging platform (全链路日志方案 v2.0 / V3 §6) ===
LOG_LEVEL=INFO
LOG_TO_DB=true
LOG_TO_FILE=true
# web-backend writes to /state/logs in compose; for a local uvicorn run use ./logs.
LOG_FILE_DIR=./logs
LOG_FILE_MAX_MB=100
LOG_FILE_BACKUP_COUNT=10
LOG_DB_RETENTION_DAYS=30
LOG_SLOW_REQUEST_MS=2000
LOG_SLOW_QUERY_MS=2000
LOG_SENSITIVE_KEYS=password,token,authorization,secret,api_key
CLIENT_LOG_MAX_BATCH=100
CLIENT_LOG_RATE_LIMIT_PER_MIN=600
# Optional ERROR/CRITICAL alert webhook (钉钉 / 企业微信 robot URL). Empty = disabled.
LOG_ALERT_WEBHOOK=
LOG_ALERT_MIN_LEVEL=ERROR
LOG_ALERT_RATE_PER_MIN=20
