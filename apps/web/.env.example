# Copy to .env and adjust. The backend reads these via Pydantic Settings.

# === Deployment (production only — read by docker-compose.yml, not by the app itself) ===
# GHCR image to pull. MUST be all-lowercase. Leave UNSET in dev so compose builds from source.
#   WEB_IMAGE=ghcr.io/<your-github-username>/<your-repo-name>:latest
# Host port to expose (container always listens on 8000).
WEB_PORT=8000

# Absolute path to the quant_data data root (raw/reference/metadata/derived live here)
QUANT_DATA_ROOT=./data

# Audit/app database (users, audit log, jobs, chart templates). SQLite by default; Postgres also works.
AUDIT_DB_URL=sqlite:///./quant_web_audit.db

# JWT signing secret — CHANGE IN PRODUCTION
JWT_SECRET=dev-secret-change-me-in-prod

# CORS allow-list (comma separated). The Vite dev server runs on 5173.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Serve a built SPA from FastAPI (set to the absolute path of frontend/dist). Leave empty in dev.
FRONTEND_DIST=

# In-process job pool size
JOB_WORKERS=4

# Seed demo users (admin/editor/viewer) on first launch when the user table is empty
SEED_DEFAULT_USERS=true

# === logging platform (全链路日志方案 v2.0 §14.3) ===
LOG_LEVEL=INFO
LOG_TO_DB=true
LOG_TO_FILE=true
# Container default is /data/logs (single volume). For a local `uvicorn` run set ./logs
# (an unwritable dir auto-degrades to DB-only + a CRITICAL self-report).
LOG_FILE_DIR=./logs
LOG_FILE_MAX_MB=100
LOG_FILE_BACKUP_COUNT=10
LOG_DB_RETENTION_DAYS=30
LOG_SLOW_REQUEST_MS=2000
LOG_SLOW_QUERY_MS=2000
LOG_SENSITIVE_KEYS=password,token,authorization,secret,api_key
CLIENT_LOG_MAX_BATCH=100
CLIENT_LOG_RATE_LIMIT_PER_MIN=600
# Optional ERROR/CRITICAL alert webhook (钉钉 / 企业微信 robot URL). Empty = disabled.
LOG_ALERT_WEBHOOK=
LOG_ALERT_MIN_LEVEL=ERROR
LOG_ALERT_RATE_PER_MIN=20
