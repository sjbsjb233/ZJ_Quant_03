# ZJ Quant — minimal .gitignore.
# Keep this lean and ANCHORED. The previous GitHub Python template had an
# unanchored `lib/` rule that recursively ignored frontend/src/lib (a real bug).
# Only add a new rule when something actually needs ignoring, and prefer anchoring
# with a leading `/` or a full path so it can't collide with a source directory.

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
/build/
/dist/

# --- Node / frontend ---
node_modules/
services/web/frontend/dist/

# --- local runtime / secrets (not data we ever commit) ---
.env
*.db
/data/
.devdata/

# --- OS / local tooling ---
.DS_Store
.claude/

# --- not committed: one-time E2E suite + PR assets (kept locally) ---
playwright-tests/
pr-screenshots/
