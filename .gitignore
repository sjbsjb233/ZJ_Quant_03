# ZJ Quant — minimal .gitignore.
# Keep this lean and ANCHORED. The previous GitHub Python template had an
# unanchored `lib/` rule that recursively ignored frontend/src/lib (a real bug).
# Only add a new rule when something actually needs ignoring, and prefer anchoring
# with a leading `/` or a full path so it can't collide with a source directory.

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
/build/
/dist/

# --- Node / frontend ---
node_modules/
apps/web/frontend/dist/

# --- local runtime / secrets (not data we ever commit) ---
.env
*.db
/data/
apps/web/data/        # legacy compose bind mount — superseded by deploy/data/
.devdata/

# --- deploy/ runtime bind mounts (V3 §2.4) — auto-created on first `up`, never committed ---
/deploy/.env
/deploy/data/
/deploy/state/
/deploy/keeper-store/
/deploy/factor-store/
/deploy/logs/

# --- OS / local tooling ---
.DS_Store
.claude/

# --- not committed: one-time E2E suite + PR assets (kept locally) ---
playwright-tests/
pr-screenshots/
scratch/

# === 一次性架构迁移回归测试,禁止入库 (V3 回归方案 §11) ===
/.regression/
**/prod_sim_data/
**/baseline_golden.json
**/__snapshots__/
**/pw-report/
**/test-results/
