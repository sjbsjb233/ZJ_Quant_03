# deploy/.env.example — 复制为 deploy/.env 并按需修改 (容器化重构 V3 §2.6)。
# 这是唯一的密钥/配置入口；docker-compose.yml 只读这一份。.env 已被 .gitignore。

# ═══ 部署 (docker-compose.yml 读取) ═══════════════════════════════════════
# 唯一公网端口 (web-frontend nginx 容器内始终监听 80)。
WEB_PORT=80
# CORS 白名单。浏览器只与 web-frontend 单源通信,主要用于 dev 直连后端 (Vite 5173)。
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# 部署标识 (修复 A1/A2)：顶栏环境徽标 + 状态栏右侧 cluster·env 标签 (纯展示)。
# ENVIRONMENT ∈ DEV | STAGING | PROD；CLUSTER 为自由文本的集群/主机标签。
ENVIRONMENT=PROD
CLUSTER=prod-east-1

# 镜像来源 (CI publish-image.yml 已按服务 matrix 推送到 GHCR)。
# 把 OWNER/REPO 换成你的 GitHub owner/repo,例如 ghcr.io/zhejiang/zj-quant-03/web-backend:latest。
# 本地构建请改用：docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
WEB_FRONTEND_IMAGE=ghcr.io/OWNER/REPO/web-frontend:latest
WEB_BACKEND_IMAGE=ghcr.io/OWNER/REPO/web-backend:latest
DATA_KEEPER_IMAGE=ghcr.io/OWNER/REPO/data-keeper:latest
FACTOR_IMAGE=ghcr.io/OWNER/REPO/factor:latest

# ═══ 共享密钥 (所有服务) ═══════════════════════════════════════════════════
# JWT 签名密钥 —— 生产务必修改。共享以便 keeper/factor 信任 web 代理的
# X-Forwarded-User/-Role 并能直接解码 bearer token。
JWT_SECRET=change-me-in-prod
# 服务间日志上报令牌 (非用户 JWT)。data-keeper / factor 携带 X-Log-Token: <此值>
# POST 结构化日志到 web-backend /logs/ingest。
LOG_INGEST_TOKEN=change-me-log-token

# ═══ data-keeper (唯一写者) ════════════════════════════════════════════════
# 进程内调度 (自治采集 / 质检 / 维护)。false = 关 (回滚位)。
ENABLE_SCHEDULER=true
# tushare 备源 token (akshare 主源无需 token)。留空则禁用 tushare 兜底。
TUSHARE_TOKEN=

# ═══ factor 服务 ═══════════════════════════════════════════════════════════
FACTOR_CONCURRENCY=4
FACTOR_RESERVE_INTERACTIVE=1
FACTOR_POLL_INTERVAL_MS=1000

# ═══ 日志平台 (全链路日志方案 v2.0 / V3 §4 · §6) ══════════════════════════
LOG_LEVEL=INFO
LOG_DB_RETENTION_DAYS=30
# 分层日志可见性 (V3 §4.2)：分号分隔的 "role:source,source" 段；admin 恒为全开。
# editor 看数据/因子/网关/前端四层；viewer 只看前端层。逗号分隔多个 source。
LOG_VISIBLE_SOURCES=editor:data,factor,backend,frontend;viewer:frontend

# ═══ dev 叠加层端口 (仅 docker-compose.dev.yml 用到) ═══════════════════════
# 直连各服务调试端口；不影响生产 (生产只暴露 WEB_PORT)。
WEB_BACKEND_PORT=8000
FACTOR_API_PORT=8100
KEEPER_PORT=8300
