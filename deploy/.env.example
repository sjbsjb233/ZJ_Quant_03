# deploy/.env.example — 复制为 deploy/.env 并按需修改 (容器化重构 V3 §2.6)。
# 这是唯一的密钥/配置入口；docker-compose.yml 只读这一份。.env 已被 .gitignore。

# ═══ 部署 (docker-compose.yml 读取) ═══════════════════════════════════════
# 唯一公网端口 (web-frontend nginx 容器内始终监听 80)。
WEB_PORT=80
# CORS 白名单。浏览器只与 web-frontend 单源通信,主要用于 dev 直连后端 (Vite 5173)。
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# 部署标识 (修复 A1/A2)：顶栏环境徽标 + 状态栏右侧 cluster·env 标签 (纯展示)。
# ENVIRONMENT ∈ DEV | STAGING | PROD；CLUSTER 为自由文本的集群/主机标签。
ENVIRONMENT=PROD
CLUSTER=prod-east-1

# 镜像来源 (CI publish-image.yml 已按服务 matrix 推送到 GHCR)。
# 把 OWNER/REPO 换成你的 GitHub owner/repo,例如 ghcr.io/zhejiang/zj-quant-03/web-backend:latest。
# 本地构建请改用：docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
WEB_FRONTEND_IMAGE=ghcr.io/OWNER/REPO/web-frontend:latest
WEB_BACKEND_IMAGE=ghcr.io/OWNER/REPO/web-backend:latest
DATA_KEEPER_IMAGE=ghcr.io/OWNER/REPO/data-keeper:latest
FACTOR_IMAGE=ghcr.io/OWNER/REPO/factor:latest
OBS_SENTINEL_IMAGE=ghcr.io/OWNER/REPO/obs-sentinel:latest

# ═══ 共享密钥 (所有服务) ═══════════════════════════════════════════════════
# JWT 签名密钥 —— 生产务必修改。共享以便 keeper/factor 信任 web 代理的
# X-Forwarded-User/-Role 并能直接解码 bearer token。
JWT_SECRET=change-me-in-prod
# 服务间日志上报令牌 (非用户 JWT)。data-keeper / factor 携带 X-Log-Token: <此值>
# POST 结构化日志到 web-backend /logs/ingest。
LOG_INGEST_TOKEN=change-me-log-token

# ═══ data-keeper (唯一写者) ════════════════════════════════════════════════
# 进程内调度 (自治采集 / 质检 / 维护)。false = 关 (回滚位)。
ENABLE_SCHEDULER=true
# tushare 备源 token (akshare 主源无需 token)。留空则禁用 tushare 兜底。
TUSHARE_TOKEN=
# 任务自对账 / 回收 (可观测层重构方案 §6.5 · D5/D6)。进程猝死后启动翻孤儿 + 回收卡死。
RECONCILE_ON_START=true
JOB_TIMEOUT_MIN={"maintenance":15,"quality":10,"crawl":30,"default":20}
JOB_HEARTBEAT_STALE_MIN=5
REAPER_TICK_SEC=60

# ═══ factor 服务 ═══════════════════════════════════════════════════════════
FACTOR_CONCURRENCY=4
FACTOR_RESERVE_INTERACTIVE=1
FACTOR_POLL_INTERVAL_MS=1000

# ═══ 内存护栏 (修复 2026-06-01 "/" 盘打满事件) ═════════════════════════════
# 两层防护:
#   ① 容器级 mem_limit —— 进程总内存硬上限。超限 → cgroup OOM-kill(SIGKILL,
#      不产生 core dump),避免单个 compute() 涨到 ~20GB 拖垮宿主机、或写出 8GB
#      core 到未映射的 /app 层把 "/" 盘打满。memswap_limit 已与之相等(禁 swap,
#      宿主机 swap 已紧张),超限即刻被杀而非 swap 抖动。
#   ② DuckDB 级 QUANT_DUCKDB_MEMORY_LIMIT —— 只约束 DuckDB 缓冲区;超限时 spill
#      到 QUANT_DUCKDB_TEMP_DIR(compose 已指向 10TB 的 sdb)而非吃满内存。
# 这些是"天花板"不是预留;按宿主机总内存调整。宿主机仅 ~31G 且与其他容器共享,
# 下面默认值之和已接近上限 —— 内存吃紧时优先调小 FACTOR_WORKER 或 FACTOR_CONCURRENCY。
# factor-worker 上限由 FACTOR_CONCURRENCY 个并发任务共享 —— 两者一起调。
# (web-backend 的 12g + 2GB 已在 docker-compose.yml 内联,无需在此配置。)
FACTOR_WORKER_MEM_LIMIT=12g
FACTOR_API_MEM_LIMIT=6g
DATA_KEEPER_MEM_LIMIT=8g
# web-backend CPU 上限(核数)。按宿主物理核数预留余量,别占满
# (2026-06-01 P0:可视化页全表去重排序把所有核打满,健康检查/轻请求饿死)。
WEB_BACKEND_CPUS=4
FACTOR_DUCKDB_MEMORY_LIMIT=2GB
KEEPER_DUCKDB_MEMORY_LIMIT=2GB

# ═══ 内存准入闸 (内存治理方案 WP5 · quant_admission) ═══════════════════════
# 三服务(web/keeper/factor)各自进程内的内存预算闸 —— 防"本进程多任务叠加"
# 把 RSS 推过 cgroup mem_limit(OOM 根因)。cgroup 已隔离服务间,无跨进程协调。
#   ADMISSION_BUDGETS_JSON: 留空 = 用代码内 DEFAULT_BUDGETS(各任务类预算 MB,
#     与 docker-compose.yml 锚点注释逐字一致)。要覆盖就在此设【整段 JSON】——
#     ⚠ 不能在 compose 里内联默认 JSON(${VAR:-{…}} 会被 JSON 的第一个 } 截断),
#     所以默认走代码常量;只有这里显式给整段才生效。WP2/3 完成后按生产规模重标定。
#   预算口径(MB): factor.eval.daily=600 minute=4500 correlation=400
#                keeper.compact=800 web.rows.transform=1200 web.charts.heavy=512 *.light=64
ADMISSION_BUDGETS_JSON=
# 进程常驻 + 突发预留(从 mem_limit 里扣掉再算可放行预算)。
ADMISSION_RESERVE_MB=1024
# D16 哨兵阈值:同一任务类 deferred 滞留 / 排干模式持续 超过 N 分钟即告警。
# 同时下发给闸(自报 stuck 事件)与 web 评估器(规则页渲染)。
ADMISSION_DEFERRED_WARN_MIN=10
ADMISSION_DRAINING_WARN_MIN=30
# 声明式独占任务类(逗号分隔)—— 预算≈整容器、只能独占跑的类。
# 留空 = 用代码默认 "factor.eval.minute"(compose 锚点已透传,空串视为未设)。
ADMISSION_EXCLUSIVE_CLASSES=

# ═══ CPU 配额 (内存治理方案 WP6) ═══════════════════════════════════════════
# 消三处 N× 超卖:① DuckDB 每连接默认抢满核 ② polars 线程池 ③ BLAS/numpy。
# 每连接/进程线程 = 可用核 ÷ 重任务槽;*_DUCKDB_THREADS 留 auto = 让代码按
# cgroup cpuset 自动推导。容器 cpus 上限按宿主物理核数预留余量(别占满,
# 否则健康检查/轻请求饿死,2026-06-01 P0)。worker 是计算重镇,占大头。
DATA_KEEPER_CPUS=2
FACTOR_API_CPUS=2
FACTOR_WORKER_CPUS=4
# 每连接 DuckDB 线程(auto = 核÷槽自动推;也可设整数硬覆盖)。
WEB_DUCKDB_THREADS=auto
KEEPER_DUCKDB_THREADS=auto
FACTOR_DUCKDB_THREADS=auto
# 重任务槽数(线程推导的除数;keeper 默认 4,web 复用 VIZ_MAX_CONCURRENT_SCANS)。
KEEPER_HEAVY_TASK_SLOTS=4
# 重读端点并发信号量(web)兼作 DuckDB 重任务槽口径。
VIZ_MAX_CONCURRENT_SCANS=3
# polars 进程线程池上限(worker;import 前由 dispatcher 入口写入,留空走自动推导)。
FACTOR_POLARS_THREADS=1
# BLAS/numpy(neutralize 的 lstsq)线程上限,各服务一份。
WEB_OMP_THREADS=1
KEEPER_OMP_THREADS=1
FACTOR_API_OMP_THREADS=1
FACTOR_OMP_THREADS=1

# ═══ /rows 变换路径护栏 (内存治理方案 WP1.3) ═══════════════════════════════
# 复权/重算复权浏览在内存物化:行数超此上限即 4xx 引导缩小范围,而非吃满堆。
# 按 web-backend mem_limit 调(200000 行 ≈ 200MB,远低于 12g)。
WEB_TRANSFORM_ROW_CAP=200000

# ═══ 日志平台 (全链路日志方案 v2.0 / V3 §4 · §6) ══════════════════════════
LOG_LEVEL=INFO
LOG_DB_RETENTION_DAYS=30
# 分层日志可见性 (V3 §4.2 + 可观测层方案 §6.1)：分号分隔的 "role:source,source" 段；
# admin 恒为全开。editor 看 数据/因子/网关/前端/监控 五层；viewer 只看前端层。
LOG_VISIBLE_SOURCES=editor:data,factor,backend,frontend,monitor;viewer:frontend

# ═══ 可观测层 · 两层模型 (可观测层重构方案 §9.2) ══════════════════════════
# 第二层 · 后端评估器 (web-backend 进程内线程, false = 关) — 日志派生检测 D5/D6/D8–D12。
MONITOR_ENABLED=true
MONITOR_EVAL_TICK_SEC=30
# 哨兵上报的 conditions 仅在 sentinel_last_seen ≤ S 秒内才进台账 (盲时停喂, D12 兜底)。
SIGNAL_FRESH_SEC=120
# 评估器阈值：死人开关 (Hh 无成功)、错误率 (窗口超 T/Tc 条)、某层静默 (按层分钟)。
DEADMAN_HOURS=25
ERR_RATE_WARN=10
ERR_RATE_CRIT=50
LAYER_SILENCE_MIN=data=20,factor=30,backend=15
# 告警 webhook (opt-in, 复用 Alerter 文本格式)；空 = 不推送。MIN_LEVEL ∈ info|warn|error|critical。
LOG_ALERT_WEBHOOK=
MONITOR_ALERT_MIN_LEVEL=error

# 第一层 · 心跳/基建哨兵 (obs-sentinel 外置容器) — L0 存活 + D1–D4 + D7 + D13–D15。
# 哨兵自检带时间窗/持续态, 把判定作为 conditions 上报后端台账 + 直推前端状态帧。
# SENTINEL_INTERVAL_SEC = 深扫 (docker stats + size=true inspect, cpu/mem/core-dump) 节拍;
# OBS_LIVENESS_INTERVAL_SEC = L0 存活快扫 (轻量 HTTP 探测) 节拍 → 某层崩 ≤ 该值即变红 (AC-1)。
SENTINEL_INTERVAL_SEC=30
OBS_LIVENESS_INTERVAL_SEC=2
RESTART_STORM_COUNT=3
RESTART_STORM_WINDOW_MIN=10
UNHEALTHY_FOR_SEC=90
MEM_PRESSURE_PCT=90
MEM_PRESSURE_FOR_SEC=120
# 第一层新检测器阈值 (本次盲区: 磁盘 / CPU / core-dump / 存活探测)。
# 同名同步下发给 web-backend (规则页渲染) 与 obs-sentinel (实际检测)。
DISK_WARN_PCT=85
DISK_CRIT_PCT=95
CPU_SAT_PCT=90
CPU_SAT_FOR_SEC=120
CORE_DUMP_RW_GB=2
LIVENESS_PROBE_TIMEOUT_SEC=2
# D13 磁盘: 容器内 statvfs 路径 (宿主分区 :ro 挂在这些路径; 缺失自动跳过)。放开 sdb
# 需同时在 docker-compose.yml 放开 - /mnt/sdb:/host-sdb:ro 挂载。
OBS_DISK_MOUNTS=/=/host-root,/mnt/sdb=/host-sdb
# 哨兵只读 HTTP/SSE 状态帧服务 (经 nginx /obs/ 反代, 不发布公网)。
OBS_HTTP_PORT=8400
OBS_STATUS_PUSH_SEC=10
# 注: 状态帧 JWT 用上面共享的 JWT_SECRET 本地 HS256 校验 (哨兵不回调 backend)。

# ═══ 日志回填自愈 (可观测层重构方案 §8.3②) ════════════════════════════════
# backend 宕机窗口各层只落本地 JSONL → 恢复后扫描补齐中枢 (按 trace_id/ts/event 去重)。
LOG_BACKFILL_ON_START=true
LOG_BACKFILL_DIRS=/backfill/keeper;/backfill/factor;/backfill/sentinel
LOG_BACKFILL_SINCE_HOURS=48

# ═══ dev 叠加层端口 (仅 docker-compose.dev.yml 用到) ═══════════════════════
# 直连各服务调试端口；不影响生产 (生产只暴露 WEB_PORT)。
WEB_BACKEND_PORT=8000
FACTOR_API_PORT=8100
KEEPER_PORT=8300
